	/// Jogo em que o gol saiu, com o placar final (rótulo).
	column jogo = LOOKUPVALUE ( fato_partida[confronto], fato_partida[id_partida], fato_gol[id_partida] )
		dataType: string
		lineageTag: 29b895ab-681f-53d7-9fec-32b089fe7a61
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fato_gol = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaProjeto & "powerbi\dados\fato_gol.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    // Colunas do contrato da view; uma coluna ainda não exportada entra vazia (null), nunca como zero.
				    Colunas = Table.SelectColumns(Cabecalhos, {"id_gol", "id_partida", "rodada", "data_partida", "id_jogador", "id_clube_jogador", "id_clube_beneficiado", "mando", "minuto", "acrescimo", "periodo", "tipo", "minuto_texto", "faixa_minuto"}, MissingField.UseNull),
				    VaziosComoNulos = Table.ReplaceValue(Colunas, "", null, Replacer.ReplaceValue, Table.ColumnNames(Colunas)),
				    // Localidade en-US: os decimais do CSV usam ponto.
				    Tipos = Table.TransformColumnTypes(VaziosComoNulos, {{"id_gol", Int64.Type}, {"id_partida", Int64.Type}, {"rodada", Int64.Type}, {"data_partida", type date}, {"id_jogador", type text}, {"id_clube_jogador", type text}, {"id_clube_beneficiado", type text}, {"mando", type text}, {"minuto", Int64.Type}, {"acrescimo", Int64.Type}, {"periodo", type text}, {"tipo", type text}, {"minuto_texto", type text}, {"faixa_minuto", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

