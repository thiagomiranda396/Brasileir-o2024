/// Grão: gol (929). Faixas de 15 minutos; acréscimos ficam na faixa do fim do tempo.
table fato_gol
	lineageTag: 92a4007a-c7d3-5969-af72-754b1c5a82b9

	column id_gol
		dataType: int64
		formatString: 0
		lineageTag: 27507c69-ca2e-5d01-bbd4-c3976887bef8
		summarizeBy: none
		sourceColumn: id_gol

		annotation SummarizationSetBy = Automatic

	column id_partida
		dataType: int64
		formatString: 0
		lineageTag: 0c9bd0b6-9698-51fa-b847-4569a239efb8
		summarizeBy: none
