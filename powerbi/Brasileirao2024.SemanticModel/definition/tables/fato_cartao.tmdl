	partition fato_cartao = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaProjeto & "powerbi\dados\fato_cartao.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    // Colunas do contrato da view; uma coluna ainda não exportada entra vazia (null), nunca como zero.
				    Colunas = Table.SelectColumns(Cabecalhos, {"id_cartao", "id_partida", "rodada", "data_partida", "id_jogador", "id_clube", "mando", "cartao", "minuto", "acrescimo", "periodo"}, MissingField.UseNull),
				    VaziosComoNulos = Table.ReplaceValue(Colunas, "", null, Replacer.ReplaceValue, Table.ColumnNames(Colunas)),
				    // Localidade en-US: os decimais do CSV usam ponto.
				    Tipos = Table.TransformColumnTypes(VaziosComoNulos, {{"id_cartao", Int64.Type}, {"id_partida", Int64.Type}, {"rodada", Int64.Type}, {"data_partida", type date}, {"id_jogador", type text}, {"id_clube", type text}, {"mando", type text}, {"cartao", type text}, {"minuto", Int64.Type}, {"acrescimo", Int64.Type}, {"periodo", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

