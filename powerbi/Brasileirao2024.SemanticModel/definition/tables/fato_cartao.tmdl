/// Grão: cartão (2.096). Dado da fonte, sem conferência independente.
table fato_cartao
	lineageTag: 1d6b0b80-6212-5d83-aa72-22862927ceb2

	column id_cartao
		dataType: int64
		formatString: 0
		lineageTag: 84fd83a3-7d15-583b-a2fa-9d6d6516c85d
		summarizeBy: none
