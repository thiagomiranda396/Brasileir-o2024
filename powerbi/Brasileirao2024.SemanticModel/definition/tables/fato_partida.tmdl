	/// Rótulo do jogo com o placar (ex.: INT 2 x 1 BAH).
	column confronto = fato_partida[id_mandante] & " " & fato_partida[gols_mandante] & " x " & fato_partida[gols_visitante] & " " & fato_partida[id_visitante]
		dataType: string
		lineageTag: 3deb2491-8764-5b7c-9ae5-dfd52c441889
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fato_partida = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaProjeto & "powerbi\dados\fato_partida.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    // Colunas do contrato da view; uma coluna ainda não exportada entra vazia (null), nunca como zero.
				    Colunas = Table.SelectColumns(Cabecalhos, {"id_partida", "rodada", "data_partida", "hora_inicio", "hora_explicita", "id_mandante", "id_visitante", "gols_mandante", "gols_visitante", "gols_mandante_1t", "gols_visitante_1t", "total_gols", "resultado", "resultado_descricao", "estadio", "tecnico_mandante", "tecnico_visitante", "formacao_mandante", "formacao_visitante"}, MissingField.UseNull),
				    VaziosComoNulos = Table.ReplaceValue(Colunas, "", null, Replacer.ReplaceValue, Table.ColumnNames(Colunas)),
				    // O PostgreSQL exporta booleanos como t/f.
				    Logicos = Table.TransformColumns(VaziosComoNulos, {{"hora_explicita", each if _ = null then null else _ = "t", type logical}}),
				    // Localidade en-US: os decimais do CSV usam ponto.
				    Tipos = Table.TransformColumnTypes(Logicos, {{"id_partida", Int64.Type}, {"rodada", Int64.Type}, {"data_partida", type date}, {"hora_inicio", type time}, {"id_mandante", type text}, {"id_visitante", type text}, {"gols_mandante", Int64.Type}, {"gols_visitante", Int64.Type}, {"gols_mandante_1t", Int64.Type}, {"gols_visitante_1t", Int64.Type}, {"total_gols", Int64.Type}, {"resultado", type text}, {"resultado_descricao", type text}, {"estadio", type text}, {"tecnico_mandante", type text}, {"tecnico_visitante", type text}, {"formacao_mandante", type text}, {"formacao_visitante", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

