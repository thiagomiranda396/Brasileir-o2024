/// Grão: jogador × clube (587). Assistências e jogos sem sofrer gol vêm de rankings parciais da Wikipédia (vazio = fora do ranking).
table jogador_estatisticas
	lineageTag: b2c5447f-d1c1-5e61-a72c-8f141f5d7c7a

	column id_jogador
		dataType: string
		lineageTag: 973e7344-3de2-56eb-aa4e-5e75c32447a6
		summarizeBy: none
		sourceColumn: id_jogador

		annotation SummarizationSetBy = Automatic

	column nome_exibicao
		dataType: string
		lineageTag: 0bbaeb0f-8140-58c7-88ef-0c1628f78363
		summarizeBy: none
		sourceColumn: nome_exibicao

		annotation SummarizationSetBy = Automatic

	column id_clube
		dataType: string
		lineageTag: 620416bc-4ecc-5a5c-9df4-d4fa5cfa00cc
		summarizeBy: none
		sourceColumn: id_clube

		annotation SummarizationSetBy = Automatic

	column clube
		dataType: string
		lineageTag: da149bd7-98b1-5a5f-bb8c-242b5575834d
		summarizeBy: none
		sourceColumn: clube

		annotation SummarizationSetBy = Automatic

	column posicao
		dataType: string
		lineageTag: f1ba622d-c26a-57d6-8e38-cd2514593699
		summarizeBy: none
		sourceColumn: posicao

		annotation SummarizationSetBy = Automatic

	column gols
		dataType: int64
		formatString: 0
		lineageTag: e129be10-df03-550a-acb1-e494cdaeb5b3
		summarizeBy: none
		sourceColumn: gols

		annotation SummarizationSetBy = Automatic

	column gols_penalti
		dataType: int64
		formatString: 0
		lineageTag: 91d9a8aa-de84-52e2-9b5e-243557e0248d
		summarizeBy: none
		sourceColumn: gols_penalti

		annotation SummarizationSetBy = Automatic

	column gols_contra
		dataType: int64
		formatString: 0
		lineageTag: e0266a52-616a-5f0e-b5d5-9b7b814e622c
		summarizeBy: none
		sourceColumn: gols_contra

		annotation SummarizationSetBy = Automatic

	column cartoes_amarelos
		dataType: int64
		formatString: 0
		lineageTag: 2d86ec52-29a6-5bc7-9d03-683f04fae862
		summarizeBy: none
		sourceColumn: cartoes_amarelos

		annotation SummarizationSetBy = Automatic

	column cartoes_vermelhos
		dataType: int64
		formatString: 0
		lineageTag: 9c2ed36e-b5e6-586e-adec-bf1d05f50201
		summarizeBy: none
		sourceColumn: cartoes_vermelhos

		annotation SummarizationSetBy = Automatic

	/// Ranking parcial da Wikipédia; vazio fora do ranking (nunca zero).
	column assistencias
		dataType: int64
		formatString: 0
		lineageTag: 2a261977-6ffc-5b8d-8aee-c809d395183d
		summarizeBy: none
		sourceColumn: assistencias

		annotation SummarizationSetBy = Automatic

	/// Ranking parcial da Wikipédia (goleiros).
	column jogos_sem_sofrer_gols
		dataType: int64
		formatString: 0
		lineageTag: f6969d7f-f478-5fb2-9df8-6a381f0145ce
		summarizeBy: none
		sourceColumn: jogos_sem_sofrer_gols

		annotation SummarizationSetBy = Automatic

	column selecao_do_campeonato
		dataType: boolean
		lineageTag: e0ce8a00-19b4-5d8b-84cd-bb634d0a4634
		summarizeBy: none
		sourceColumn: selecao_do_campeonato

		annotation SummarizationSetBy = Automatic

	partition jogador_estatisticas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaProjeto & "powerbi\dados\jogador_estatisticas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    // Colunas do contrato da view; uma coluna ainda não exportada entra vazia (null), nunca como zero.
				    Colunas = Table.SelectColumns(Cabecalhos, {"id_jogador", "nome_exibicao", "id_clube", "clube", "posicao", "gols", "gols_penalti", "gols_contra", "cartoes_amarelos", "cartoes_vermelhos", "assistencias", "jogos_sem_sofrer_gols", "selecao_do_campeonato"}, MissingField.UseNull),
				    VaziosComoNulos = Table.ReplaceValue(Colunas, "", null, Replacer.ReplaceValue, Table.ColumnNames(Colunas)),
				    // O PostgreSQL exporta booleanos como t/f.
				    Logicos = Table.TransformColumns(VaziosComoNulos, {{"selecao_do_campeonato", each if _ = null then null else _ = "t", type logical}}),
				    // Localidade en-US: os decimais do CSV usam ponto.
				    Tipos = Table.TransformColumnTypes(Logicos, {{"id_jogador", type text}, {"nome_exibicao", type text}, {"id_clube", type text}, {"clube", type text}, {"posicao", type text}, {"gols", Int64.Type}, {"gols_penalti", Int64.Type}, {"gols_contra", Int64.Type}, {"cartoes_amarelos", Int64.Type}, {"cartoes_vermelhos", Int64.Type}, {"assistencias", Int64.Type}, {"jogos_sem_sofrer_gols", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

