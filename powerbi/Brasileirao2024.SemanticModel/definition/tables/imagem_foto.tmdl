/// Grão: pedaço da foto do jogador (base64). Gerada por powerbi/gerar_imagens.py.
table imagem_foto
	isHidden
	lineageTag: 49c90a74-982f-550b-9a49-e219c687d10d

	column id_jogador
		dataType: string
		isHidden
		lineageTag: 677d9ce6-9d1f-5939-9790-a15e8d07c64d
		summarizeBy: none
		sourceColumn: id_jogador

		annotation SummarizationSetBy = Automatic

	/// Ordem do pedaço.
	column parte
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d400f97e-7b07-5c7e-8aa9-e4524030d462
		summarizeBy: none
		sourceColumn: parte

		annotation SummarizationSetBy = Automatic

	/// Pedaço do data URI da imagem.
	column conteudo
		dataType: string
		isHidden
		lineageTag: 55885a1f-932b-5c80-954d-2cfee2c02dd6
		summarizeBy: none
		sourceColumn: conteudo

		annotation SummarizationSetBy = Automatic

	partition imagem_foto = m
		mode: import
		source =
				let
				    // Arquivo opcional: sem ele, a tabela fica vazia e o relatório abre do mesmo jeito.
				    Arquivo = try Table.Buffer(Csv.Document(File.Contents(PastaProjeto & "powerbi\dados\imagem_foto.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])) otherwise null,
				    Cabecalhos = if Arquivo = null then #table({"id_jogador", "parte", "conteudo"}, {}) else Table.PromoteHeaders(Arquivo, [PromoteAllScalars = true]),
				    // Colunas do contrato da view; uma coluna ainda não exportada entra vazia (null), nunca como zero.
				    Colunas = Table.SelectColumns(Cabecalhos, {"id_jogador", "parte", "conteudo"}, MissingField.UseNull),
				    VaziosComoNulos = Table.ReplaceValue(Colunas, "", null, Replacer.ReplaceValue, Table.ColumnNames(Colunas)),
				    // Localidade en-US: os decimais do CSV usam ponto.
				    Tipos = Table.TransformColumnTypes(VaziosComoNulos, {{"id_jogador", type text}, {"parte", Int64.Type}, {"conteudo", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

