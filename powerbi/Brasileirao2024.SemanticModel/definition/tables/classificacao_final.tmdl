	/// Vagas efetivas de 2024 (Libertadores até o 8º).
	column destino
		dataType: string
		lineageTag: 61cf431b-2d8d-5073-93e6-7616d9d076c5
		summarizeBy: none
		sourceColumn: destino

		annotation SummarizationSetBy = Automatic

	partition classificacao_final = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaProjeto & "powerbi\dados\classificacao_final.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    // Colunas do contrato da view; uma coluna ainda não exportada entra vazia (null), nunca como zero.
				    Colunas = Table.SelectColumns(Cabecalhos, {"posicao", "ordem_exibicao", "id_clube", "clube", "jogos", "pontos", "vitorias", "empates", "derrotas", "gols_pro", "gols_contra", "saldo", "aproveitamento", "empate_nao_resolvido", "destino"}, MissingField.UseNull),
				    VaziosComoNulos = Table.ReplaceValue(Colunas, "", null, Replacer.ReplaceValue, Table.ColumnNames(Colunas)),
				    // O PostgreSQL exporta booleanos como t/f.
				    Logicos = Table.TransformColumns(VaziosComoNulos, {{"empate_nao_resolvido", each if _ = null then null else _ = "t", type logical}}),
				    // Localidade en-US: os decimais do CSV usam ponto.
				    Tipos = Table.TransformColumnTypes(Logicos, {{"posicao", Int64.Type}, {"ordem_exibicao", Int64.Type}, {"id_clube", type text}, {"clube", type text}, {"jogos", Int64.Type}, {"pontos", Int64.Type}, {"vitorias", Int64.Type}, {"empates", Int64.Type}, {"derrotas", Int64.Type}, {"gols_pro", Int64.Type}, {"gols_contra", Int64.Type}, {"saldo", Int64.Type}, {"aproveitamento", type number}, {"destino", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

