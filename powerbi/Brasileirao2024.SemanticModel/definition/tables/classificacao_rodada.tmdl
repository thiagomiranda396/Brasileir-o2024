	partition classificacao_rodada = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaProjeto & "powerbi\dados\classificacao_rodada.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    // Colunas do contrato da view; uma coluna ainda não exportada entra vazia (null), nunca como zero.
				    Colunas = Table.SelectColumns(Cabecalhos, {"rodada", "id_clube", "clube", "posicao", "ordem_exibicao", "jogos", "pontos", "vitorias", "empates", "derrotas", "gols_pro", "gols_contra", "saldo", "aproveitamento", "empate_nao_resolvido", "decidido_por_confronto"}, MissingField.UseNull),
				    VaziosComoNulos = Table.ReplaceValue(Colunas, "", null, Replacer.ReplaceValue, Table.ColumnNames(Colunas)),
				    // O PostgreSQL exporta booleanos como t/f.
				    Logicos = Table.TransformColumns(VaziosComoNulos, {{"empate_nao_resolvido", each if _ = null then null else _ = "t", type logical}, {"decidido_por_confronto", each if _ = null then null else _ = "t", type logical}}),
				    // Localidade en-US: os decimais do CSV usam ponto.
				    Tipos = Table.TransformColumnTypes(Logicos, {{"rodada", Int64.Type}, {"id_clube", type text}, {"clube", type text}, {"posicao", Int64.Type}, {"ordem_exibicao", Int64.Type}, {"jogos", Int64.Type}, {"pontos", Int64.Type}, {"vitorias", Int64.Type}, {"empates", Int64.Type}, {"derrotas", Int64.Type}, {"gols_pro", Int64.Type}, {"gols_contra", Int64.Type}, {"saldo", Int64.Type}, {"aproveitamento", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

