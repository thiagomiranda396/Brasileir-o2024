/// Calendário de 2024 (tabela calculada), ligado a fato_partida[data_partida].
table dim_calendario
	lineageTag: 08150c1f-1220-5dcf-9d5e-5762b6268505
	dataCategory: Time

	column Data
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: 61f8c9c6-299c-5b7a-80a1-d4e39c501b3a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Data]

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: ba66cf76-94e5-5f09-8a27-372fa32a23db
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ano]

		annotation SummarizationSetBy = Automatic

	column Mês
		dataType: int64
		formatString: 0
		lineageTag: 53c97693-b21b-58fc-9cb7-3d74f07942ad
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mês]

		annotation SummarizationSetBy = Automatic

	column 'Nome do mês'
		dataType: string
		lineageTag: 735ff748-9b38-5afc-bf2f-71dd600788ed
		summarizeBy: none
		isNameInferred
		sourceColumn: [Nome do mês]
		sortByColumn: Mês

		annotation SummarizationSetBy = Automatic

	column 'Dia da semana'
		dataType: string
		lineageTag: 416d2459-3f64-59c3-bdc0-6964ee4224d9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Dia da semana]
		sortByColumn: 'Nº dia da semana'

		annotation SummarizationSetBy = Automatic

	column 'Nº dia da semana'
		dataType: int64
		formatString: 0
		lineageTag: 8acc334e-d0a4-517c-b808-d76ccc56ca5b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Nº dia da semana]

		annotation SummarizationSetBy = Automatic

	partition dim_calendario = calculated
		mode: import
		source =
				VAR base = CALENDAR ( DATE ( 2024, 4, 1 ), DATE ( 2024, 12, 31 ) )
				RETURN
				    ADDCOLUMNS (
				        SELECTCOLUMNS ( base, "Data", [Date] ),
				        "Ano", YEAR ( [Data] ),
				        "Mês", MONTH ( [Data] ),
				        "Nome do mês", FORMAT ( [Data], "mmmm", "pt-BR" ),
				        "Dia da semana", FORMAT ( [Data], "dddd", "pt-BR" ),
				        "Nº dia da semana", WEEKDAY ( [Data], 2 )
				    )

