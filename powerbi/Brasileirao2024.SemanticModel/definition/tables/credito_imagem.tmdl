/// Grão: imagem exibida (escudo ou foto). Autor e licença de cada arquivo da Wikimedia Commons.
table credito_imagem
	lineageTag: 212688b0-9c65-5e5d-862e-66246e6dc85b

	/// Escudo ou Foto.
	column tipo
		dataType: string
		lineageTag: 1eea6de6-7db6-5774-a804-b5ce003d4216
		summarizeBy: none
		sourceColumn: tipo

		annotation SummarizationSetBy = Automatic

	column id_clube
		dataType: string
		lineageTag: af636766-e7d2-5099-9e38-ba99031c8cb1
		summarizeBy: none
		sourceColumn: id_clube

		annotation SummarizationSetBy = Automatic

	column id_jogador
		dataType: string
		lineageTag: 72477b6e-c928-5821-a637-3ffecdf81314
		summarizeBy: none
		sourceColumn: id_jogador

		annotation SummarizationSetBy = Automatic

	column nome
		dataType: string
		lineageTag: 2276b487-6f8a-5828-b363-f432e57d4c2a
		summarizeBy: none
		sourceColumn: nome

		annotation SummarizationSetBy = Automatic

	column arquivo
		dataType: string
		lineageTag: fc147421-1e8e-5f45-943b-bc5f65aeae3d
		summarizeBy: none
		sourceColumn: arquivo

		annotation SummarizationSetBy = Automatic

	column url_imagem
		dataType: string
		lineageTag: 3aec2b61-ba0a-57e8-a274-95b0032dafd2
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: url_imagem

		annotation SummarizationSetBy = Automatic

	column pagina_arquivo
		dataType: string
		lineageTag: b33ec06d-4727-5ecc-b5c1-355c2c8e6cb5
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: pagina_arquivo

		annotation SummarizationSetBy = Automatic

	column autor
		dataType: string
		lineageTag: a56593dc-64e8-549c-bc2b-c94485e67d6f
		summarizeBy: none
		sourceColumn: autor

		annotation SummarizationSetBy = Automatic

	column licenca
		dataType: string
		lineageTag: fb485b4a-f7b6-5c7d-aa89-5e983ee48232
		summarizeBy: none
		sourceColumn: licenca

		annotation SummarizationSetBy = Automatic

	column licenca_url
		dataType: string
		lineageTag: 2450e57d-729f-5b75-af2c-c4b0f4685627
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: licenca_url

		annotation SummarizationSetBy = Automatic

	partition credito_imagem = m
		mode: import
		source =
				let
				    // Arquivo opcional: sem ele, a tabela fica vazia e o relatório abre do mesmo jeito.
				    Arquivo = try Table.Buffer(Csv.Document(File.Contents(PastaProjeto & "powerbi\dados\credito_imagem.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])) otherwise null,
				    Cabecalhos = if Arquivo = null then #table({"tipo", "id_clube", "id_jogador", "nome", "arquivo", "url_imagem", "pagina_arquivo", "autor", "licenca", "licenca_url"}, {}) else Table.PromoteHeaders(Arquivo, [PromoteAllScalars = true]),
				    // Colunas do contrato da view; uma coluna ainda não exportada entra vazia (null), nunca como zero.
				    Colunas = Table.SelectColumns(Cabecalhos, {"tipo", "id_clube", "id_jogador", "nome", "arquivo", "url_imagem", "pagina_arquivo", "autor", "licenca", "licenca_url"}, MissingField.UseNull),
				    VaziosComoNulos = Table.ReplaceValue(Colunas, "", null, Replacer.ReplaceValue, Table.ColumnNames(Colunas)),
				    // Localidade en-US: os decimais do CSV usam ponto.
				    Tipos = Table.TransformColumnTypes(VaziosComoNulos, {{"tipo", type text}, {"id_clube", type text}, {"id_jogador", type text}, {"nome", type text}, {"arquivo", type text}, {"url_imagem", type text}, {"pagina_arquivo", type text}, {"autor", type text}, {"licenca", type text}, {"licenca_url", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

