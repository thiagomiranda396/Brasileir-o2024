		lineageTag: 53d65630-a990-598d-b3f9-0066aa7004f6

	measure '% vitórias do mandante' = DIVIDE ( [Vitórias do mandante], [Partidas] )
		formatString: 0.0%
		displayFolder: 1. Campeonato
		lineageTag: fd733e63-d007-5b5c-88da-4f6c77c59639

	measure '% empates' = DIVIDE ( [Empates], [Partidas] )
		formatString: 0.0%
		displayFolder: 1. Campeonato
		lineageTag: b3436f0f-1781-544a-95cf-1365f057afb7

	measure '% vitórias do visitante' = DIVIDE ( [Vitórias do visitante], [Partidas] )
		formatString: 0.0%
