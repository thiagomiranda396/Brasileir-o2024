	/// Pontos ganhos sobre os possíveis. A CBF trunca (Athletico 36); aqui mostramos 1 casa (36,8%). Definição oficial pendente.
	measure Aproveitamento = DIVIDE ( [Pontos], 3 * [Jogos do clube] )
		formatString: 0.0%
		displayFolder: 2. Clubes
		lineageTag: 9e9b62f8-75b6-514c-9d57-68bacf8ca60d

	measure 'Jogos sem sofrer gol' = CALCULATE ( [Jogos do clube], fato_participacao[sem_sofrer_gols] = TRUE () )
		formatString: #,0
		displayFolder: 2. Clubes
		lineageTag: 5663446a-f87e-549d-945c-ac164ea51244

	measure 'Pontos em casa' = CALCULATE ( [Pontos], fato_participacao[mando] = "Casa" )
		formatString: #,0
		displayFolder: 2. Clubes
		lineageTag: 2f912b8c-f883-53bc-8b22-42ec72b450ef

	measure 'Pontos fora' = CALCULATE ( [Pontos], fato_participacao[mando] = "Fora" )
		formatString: #,0
		displayFolder: 2. Clubes
		lineageTag: a34c0c82-a499-5067-a0ba-69f9075db9bd

	measure 'Aproveitamento em casa' = CALCULATE ( [Aproveitamento], fato_participacao[mando] = "Casa" )
		formatString: 0.0%
		displayFolder: 2. Clubes
		lineageTag: 3eb2413a-f9c4-585d-9682-1411934d8e8b

	measure 'Aproveitamento fora' = CALCULATE ( [Aproveitamento], fato_participacao[mando] = "Fora" )
		formatString: 0.0%
		displayFolder: 2. Clubes
		lineageTag: 7b1ed3ea-6ffc-5f2b-8d23-996fab23c3c6

	measure 'Média de gols pró' = DIVIDE ( [Gols pró], [Jogos do clube] )
		formatString: 0.00
		displayFolder: 2. Clubes
		lineageTag: 7d490879-e32b-5506-b47b-d8cceb27295a

	measure 'Média de gols sofridos' = DIVIDE ( [Gols contra], [Jogos do clube] )
		formatString: 0.00
		displayFolder: 2. Clubes
		lineageTag: 6aac0270-ce53-56a7-aa72-f8695558387c

	/// Pontos acumulados até a rodada do contexto.
	measure 'Pontos acumulados' =
			VAR rodadaAtual = MAX ( dim_rodada[rodada] )
			RETURN
			    CALCULATE (
			        [Pontos],
			        FILTER ( ALL ( dim_rodada[rodada] ), dim_rodada[rodada] <= rodadaAtual )
			    )
		formatString: #,0
		displayFolder: 2. Clubes
		lineageTag: c88d7007-4f88-5a6c-8278-c9dd4501673e

	/// Gols sofridos pelo clube selecionado, um a um (permite cortar por faixa de minuto). A soma é igual a [Gols contra].
	measure 'Gols sofridos (eventos)' =
			VAR clubes = VALUES ( dim_clube[id_clube] )
			VAR partidas = CALCULATETABLE ( VALUES ( fato_participacao[id_partida] ) )
			RETURN
			    IF (
			        HASONEVALUE ( dim_clube[id_clube] ),
			        CALCULATE (
			            COUNTROWS ( fato_gol ),
			            REMOVEFILTERS ( dim_clube ),
			            TREATAS ( partidas, fato_gol[id_partida] ),
			            NOT ( fato_gol[id_clube_beneficiado] IN clubes )
			        )
			    )
		formatString: #,0
		displayFolder: 2. Clubes
		lineageTag: fe178702-e368-51b8-b14f-472caa6edf25

	measure 'Nome do clube' = SELECTEDVALUE ( dim_clube[nome] )
		displayFolder: 2. Clubes
		lineageTag: 2a3c7a15-8ee8-5d5f-a3b3-f49acb0a0399

	/// Cor principal do clube selecionado; sem seleção, o verde do tema.
	measure 'Cor do clube' = COALESCE ( SELECTEDVALUE ( dim_clube[cor_primaria] ), "#06AA48" )
		displayFolder: 2. Clubes
		lineageTag: 6fc3052f-d021-523c-aa05-3a087ac33f5a

	measure 'Cor secundária do clube' = COALESCE ( SELECTEDVALUE ( dim_clube[cor_secundaria] ), "#0A4F29" )
		displayFolder: 2. Clubes
		lineageTag: 9dcc306d-197a-5e7e-9d7f-df1d2908761a

	/// Cor do clube para a faixa do título com texto branco: usa a cor principal e troca pela secundária quando a principal é clara demais (ex.: amarelo do Criciúma).
	measure 'Cor de destaque do clube' =
			VAR c1 = SELECTEDVALUE ( dim_clube[cor_primaria] )
			VAR c2 = SELECTEDVALUE ( dim_clube[cor_secundaria] )
			VAR hex = "0123456789ABCDEF"
			VAR r = ( SEARCH ( MID ( c1, 2, 1 ), hex, 1, 1 ) - 1 ) * 16 + SEARCH ( MID ( c1, 3, 1 ), hex, 1, 1 ) - 1
			VAR g = ( SEARCH ( MID ( c1, 4, 1 ), hex, 1, 1 ) - 1 ) * 16 + SEARCH ( MID ( c1, 5, 1 ), hex, 1, 1 ) - 1
			VAR b = ( SEARCH ( MID ( c1, 6, 1 ), hex, 1, 1 ) - 1 ) * 16 + SEARCH ( MID ( c1, 7, 1 ), hex, 1, 1 ) - 1
			VAR luminancia = ( 0.299 * r + 0.587 * g + 0.114 * b ) / 255
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( c1 ), "#06AA48",
			        luminancia > 0.6, c2,
			        c1
			    )
		displayFolder: 2. Clubes
		lineageTag: 81fcac6e-d464-543c-a9e8-499a26d6ad67

	/// Escudo do clube (Wikimedia Commons), embutido no modelo quando powerbi/gerar_imagens.py já rodou; senão, pela URL. Sem imagem confirmada, mostra a sigla nas cores do clube, como no site.
	measure 'Escudo ou sigla' =
			VAR embutida =
			    IF (
			        HASONEVALUE ( dim_clube[id_clube] ),
			        CONCATENATEX ( imagem_escudo, imagem_escudo[conteudo], "", imagem_escudo[parte], ASC )
			    )
			VAR url = SELECTEDVALUE ( dim_clube[escudo_url] )
			VAR sigla = SELECTEDVALUE ( dim_clube[id_clube] )
			VAR c1 = SUBSTITUTE ( SELECTEDVALUE ( dim_clube[cor_primaria] ), "#", "%23" )
			VAR c2 = SUBSTITUTE ( SELECTEDVALUE ( dim_clube[cor_secundaria] ), "#", "%23" )
			RETURN
			    SWITCH (
			        TRUE (),
			        embutida <> "", embutida,
			        NOT ISBLANK ( url ), url,
			        ISBLANK ( sigla ), BLANK (),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>"
			            & "<circle cx='50' cy='50' r='46' fill='" & c1 & "' stroke='" & c2 & "' stroke-width='6'/>"
			            & "<text x='50' y='62' font-family='Segoe UI, Arial, sans-serif' font-size='30' font-weight='700' fill='white' text-anchor='middle'>"
			            & sigla & "</text></svg>"
			    )
		displayFolder: 2. Clubes
		lineageTag: cc4bbc2c-b5d2-506d-a57d-662f6facd24c
		dataCategory: ImageUrl

	/// Posição após a rodada do contexto, lida da view (a ordem não é recalculada em DAX).
	measure 'Posição na rodada' =
			VAR rodada = MAX ( dim_rodada[rodada] )
			RETURN
			    CALCULATE ( MIN ( classificacao_rodada[posicao] ), classificacao_rodada[rodada] = rodada )
		formatString: 0
		displayFolder: 3. Classificação
		lineageTag: 083d407b-0dd7-5491-9bce-9ea77afab889

	measure 'Pontos na rodada' =
			VAR rodada = MAX ( dim_rodada[rodada] )
			RETURN
