			RETURN
			    IF ( NOT ISBLANK ( valor ) && posicao <= 1, valor )
		formatString: #,0
		displayFolder: 4. Jogadores
		lineageTag: 26eeefe3-0bb2-59a1-8d9c-d571bba14d3d

