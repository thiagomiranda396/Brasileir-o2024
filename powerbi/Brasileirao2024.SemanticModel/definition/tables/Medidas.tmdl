	/// Compara com os números de controle do projeto (SKILL.md, seção 3).
	measure 'Status da auditoria' =
			IF (
			    [Gols] = 929
			        && [Gols (conferência pelos eventos)] = 929
			        && [Partidas] = 380
			        && [Jogos do clube] = 760
			        && [Cartões] = 2096
			        && [Pontos] = 1039
			        && [Soma do saldo] = 0,
			    "OK: os números de controle conferem",
			    "DIVERGÊNCIA: confira relações e filtros"
			)
		displayFolder: 6. Auditoria
		lineageTag: 0cbef311-cf2a-58ce-90d6-c9841fdb56fa

