	/// Pontos médios por clube no período filtrado (referência para o cartão de pontos).
	measure 'Média de pontos da liga' =
			DIVIDE (
			    CALCULATE ( [Pontos], REMOVEFILTERS ( dim_clube ) ),
			    CALCULATE ( DISTINCTCOUNT ( fato_participacao[id_clube] ), REMOVEFILTERS ( dim_clube ) )
			)
		formatString: 0.0
		displayFolder: 7. Rótulos dinâmicos
		lineageTag: 02992f24-f1b8-5609-aa64-cb78c5ce58f2

