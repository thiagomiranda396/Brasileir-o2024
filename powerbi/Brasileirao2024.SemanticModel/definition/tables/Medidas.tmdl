		lineageTag: 24493a78-1816-5a55-a1ff-7a79afdc8788

	measure 'Gols contra (jogador)' = CALCULATE ( COUNTROWS ( fato_gol ), fato_gol[tipo] = "Contra" )
		formatString: #,0
		displayFolder: 4. Jogadores
		lineageTag: cfcbd0a9-7e7e-5205-96e8-91e06be540de

	/// Ranking parcial da Wikipédia: vazio = fora do ranking (nunca zero).
	measure Assistências = SUM ( jogador_estatisticas[assistencias] )
		formatString: #,0
		displayFolder: 4. Jogadores
		lineageTag: 792ffb80-0c31-5e6e-884f-724746ad8bca

	/// Ranking parcial da Wikipédia (goleiros).
	measure 'Jogos sem sofrer gol (goleiro)' = SUM ( jogador_estatisticas[jogos_sem_sofrer_gols] )
		formatString: #,0
		displayFolder: 4. Jogadores
		lineageTag: 3e7d9e1d-7d90-5965-9e44-100e461edab5

	measure 'Posição na artilharia' =
			IF (
			    [Gols do jogador] > 0,
			    RANKX ( ALL ( dim_jogador ), [Gols do jogador],, DESC, SKIP )
			)
		formatString: 0
		displayFolder: 4. Jogadores
		lineageTag: 6c8dd9cc-a929-5a5b-9fd9-8839f1f28371

	measure '% dos gols do clube' =
			VAR clube = SELECTEDVALUE ( dim_jogador[id_clube] )
			RETURN
			    DIVIDE (
			        [Gols do jogador],
			        CALCULATE ( COUNTROWS ( fato_gol ), ALL ( dim_jogador ), fato_gol[id_clube_beneficiado] = clube )
			    )
		formatString: 0.0%
		displayFolder: 4. Jogadores
		lineageTag: 19a92d2f-8244-518f-ac32-2ae41168a5f0

	/// Valor do jogador na métrica escolhida na segmentação Ranking.
	measure 'Valor no ranking' =
			SWITCH (
			    SELECTEDVALUE ( Ranking[Métrica], "Gols" ),
			    "Gols", [Gols do jogador],
			    "Assistências", [Assistências],
			    "Jogos sem sofrer gol", [Jogos sem sofrer gol (goleiro)],
			    "Gols de pênalti", [Gols de pênalti],
			    "Cartões amarelos", [Cartões amarelos],
			    "Cartões vermelhos", [Cartões vermelhos]
			)
		formatString: #,0
		displayFolder: 4. Jogadores
		lineageTag: 196d0114-ad04-54c6-8216-cf4403745f40

	/// Mantém só os 10 primeiros (empates no corte entram todos).
	measure 'Valor no ranking (top 10)' =
			VAR valor = [Valor no ranking]
			VAR posicao =
			    IF ( NOT ISBLANK ( valor ), RANKX ( ALLSELECTED ( dim_jogador ), [Valor no ranking], valor, DESC, SKIP ) )
			RETURN
			    IF ( NOT ISBLANK ( valor ) && posicao <= 10, valor )
		formatString: #,0
		displayFolder: 4. Jogadores
		lineageTag: 696e16dd-a2a8-5bfd-9e70-69b30c6884ff

