	measure 'Empates do clube' = CALCULATE ( [Jogos do clube], fato_participacao[resultado] = "E" )
		formatString: #,0
		displayFolder: 2. Clubes
		lineageTag: d0cd7209-3f36-543d-810d-ce68139e734c

	measure Derrotas = CALCULATE ( [Jogos do clube], fato_participacao[resultado] = "D" )
		formatString: #,0
		displayFolder: 2. Clubes
		lineageTag: 8356fde5-aa5b-5400-8b3f-69f344c448b0

	measure 'Gols pró' = SUM ( fato_participacao[gols_pro] )
		formatString: #,0
		displayFolder: 2. Clubes
		lineageTag: e041ea20-4cd0-57a6-a42d-9bf30ff6a4e9

	measure 'Gols contra' = SUM ( fato_participacao[gols_contra] )
		formatString: #,0
		displayFolder: 2. Clubes
