/// Medidas do dashboard. Cada uma lê a tabela do seu grão (ver powerbi/medidas.dax).
table Medidas
	lineageTag: 6c085732-01ff-579e-b671-743a9706582c

	/// Partidas no filtro (380 no campeonato).
	measure Partidas = COUNTROWS ( fato_partida )
		formatString: #,0
		displayFolder: 1. Campeonato
		lineageTag: bbc2a414-a0f5-58ee-9e6f-158f7fdd4806

	/// Gols do campeonato, lidos no grão partida (929).
	measure Gols = SUM ( fato_partida[total_gols] )
		formatString: #,0
		displayFolder: 1. Campeonato
		lineageTag: ebff3363-8a11-5463-a49e-3958accdc5ab

	measure 'Média de gols por jogo' = DIVIDE ( [Gols], [Partidas] )
		formatString: 0.00
		displayFolder: 1. Campeonato
		lineageTag: 27c66da6-b03e-53b9-b83b-d9ca5c54eda3

	measure 'Vitórias do mandante' = CALCULATE ( [Partidas], fato_partida[resultado] = "M" )
		formatString: #,0
		displayFolder: 1. Campeonato
		lineageTag: 1deba26a-3d06-5cf6-ab88-9fa173376750

	measure Empates = CALCULATE ( [Partidas], fato_partida[resultado] = "E" )
