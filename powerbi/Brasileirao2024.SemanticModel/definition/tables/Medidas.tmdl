		formatString: +0;-0;0
		displayFolder: 3. Classificação
		lineageTag: d27bc0d1-a990-5f73-abe4-ca975b1783e1

	measure 'Aproveitamento na rodada' = DIVIDE ( [Pontos na rodada], 3 * [Jogos na rodada] )
		formatString: 0.0%
		displayFolder: 3. Classificação
		lineageTag: 6f595b14-b094-5a5f-851e-fdd12f6f866f

	/// Posições ganhas (positivo) ou perdidas desde a rodada anterior. REMOVEFILTERS(dim_rodada) deixa ler a rodada anterior mesmo com uma rodada selecionada.
	measure 'Variação de posição' =
			VAR rodada = MAX ( dim_rodada[rodada] )
			VAR agora =
			    CALCULATE ( MIN ( classificacao_rodada[posicao] ), REMOVEFILTERS ( dim_rodada ), classificacao_rodada[rodada] = rodada )
			VAR antes =
			    CALCULATE ( MIN ( classificacao_rodada[posicao] ), REMOVEFILTERS ( dim_rodada ), classificacao_rodada[rodada] = rodada - 1 )
			RETURN
			    IF ( rodada > 1 && NOT ISBLANK ( agora ) && NOT ISBLANK ( antes ), antes - agora )
		formatString: """▲ ""0;""▼ ""0;""="""
		displayFolder: 3. Classificação
		lineageTag: 9ea3b35e-c5f9-566b-8899-fdae63ccd24f

	/// Posição final (classificacao_final, conferida com a CBF).
	measure 'Posição final' = MIN ( classificacao_final[posicao] )
		formatString: 0"º"
		displayFolder: 3. Classificação
		lineageTag: 7579564c-eec0-582f-949d-81e7e5e61293

	measure Campeão = CALCULATE ( SELECTEDVALUE ( classificacao_final[clube] ), classificacao_final[ordem_exibicao] = 1 )
		displayFolder: 3. Classificação
		lineageTag: b5e45ae4-8e2d-5d75-b6a4-4c22bc4954cf

	measure 'Pontos do campeão' = CALCULATE ( MAX ( classificacao_final[pontos] ), classificacao_final[ordem_exibicao] = 1 )
		formatString: #,0
		displayFolder: 3. Classificação
		lineageTag: 5996e4f2-27b3-5ec0-a4c3-7fa8ba1a6615

	measure 'Título do topo da tabela' = [Campeão] & " campeão com " & [Pontos do campeão] & " pontos"
		displayFolder: 3. Classificação
		lineageTag: a8feec93-83f4-5e29-849a-4d06a1dd6f49

	/// Cor da zona final, para formatação condicional (valor do campo).
	measure 'Cor da zona' =
			SWITCH (
			    SELECTEDVALUE ( classificacao_final[destino] ),
			    "Campeão", "#2A78D6",
			    "Libertadores (fase de grupos)", "#2A78D6",
			    "Libertadores (2ª fase)", "#86B6EF",
			    "Sul-Americana", "#1BAF7A",
			    "Rebaixado", "#D03B3B",
			    BLANK ()
			)
		displayFolder: 3. Classificação
		lineageTag: 86054331-121b-552f-b7f5-b6fb680d9f01

	/// Zona pela ordem na rodada, com as vagas finais de 2024 (Libertadores até o 8º, Sul-Americana até o 14º, rebaixamento do 17º ao 20º).
	measure 'Cor da zona na rodada' =
			VAR rodada = MAX ( dim_rodada[rodada] )
			VAR ordem =
			    CALCULATE ( MIN ( classificacao_rodada[ordem_exibicao] ), classificacao_rodada[rodada] = rodada )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( ordem ), BLANK (),
			        ordem <= 6, "#2A78D6",
			        ordem <= 8, "#86B6EF",
			        ordem <= 14, "#1BAF7A",
			        ordem >= 17, "#D03B3B",
			        "#E3E7E3"
			    )
		displayFolder: 3. Classificação
		lineageTag: e672aec3-f4f1-54c1-8248-61456e9549ee

	measure 'Cor do texto da zona' =
			VAR rodada = MAX ( dim_rodada[rodada] )
			VAR ordem =
			    CALCULATE ( MIN ( classificacao_rodada[ordem_exibicao] ), classificacao_rodada[rodada] = rodada )
			RETURN
			    IF ( ordem <= 6 || ordem >= 17, "#FFFFFF", "#14181B" )
		displayFolder: 3. Classificação
		lineageTag: 2c64e437-96dc-5116-8d9f-d3e684ae0839

	measure 'Cor do resultado' =
			SWITCH (
			    SELECTEDVALUE ( fato_participacao[resultado] ),
			    "V", "#0CA30C",
			    "E", "#6B7280",
			    "D", "#D03B3B"
			)
		displayFolder: 3. Classificação
		lineageTag: 6343fbff-f05a-5770-a021-ba8885481d38

	/// Gols marcados pelo jogador (sem gols contra).
	measure 'Gols do jogador' = CALCULATE ( COUNTROWS ( fato_gol ), fato_gol[tipo] <> "Contra" )
		formatString: #,0
		displayFolder: 4. Jogadores
		lineageTag: c7ab40e5-e200-557d-87b3-d0f69953480b

	measure 'Gols de pênalti' = CALCULATE ( COUNTROWS ( fato_gol ), fato_gol[tipo] = "Pênalti" )
		formatString: #,0
