	/// Conta os gols um a um em fato_gol. Precisa ser igual a [Gols] (929). Com um clube no filtro, são os gols a favor dele.
	measure 'Gols (conferência pelos eventos)' = COUNTROWS ( fato_gol )
		formatString: #,0
		displayFolder: 1. Campeonato
		lineageTag: 669496dd-f382-5928-9372-8c52ad1633a5

	measure 'Gols do mandante (eventos)' = CALCULATE ( [Gols (conferência pelos eventos)], fato_gol[mando] = "Casa" )
