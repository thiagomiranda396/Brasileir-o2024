	measure 'Gols pró na rodada' =
			VAR rodada = MAX ( dim_rodada[rodada] )
			RETURN
			    CALCULATE ( MAX ( classificacao_rodada[gols_pro] ), classificacao_rodada[rodada] = rodada )
		formatString: #,0
